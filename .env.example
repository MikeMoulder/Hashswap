# Copy to .env and fill in. Never commit .env.

# --- Sepolia deploy (Stage 8, and the F9 fallback if Docker stays unavailable) ---
# Public nodes rate-limit hard; use Alchemy/Infura for anything beyond a read.
SEPOLIA_RPC_URL=
# Needs Sepolia ETH. Use a throwaway key — this is a hackathon repo.
DEPLOYER_PRIVATE_KEY=

# --- Demo wallets (Stage 5 sandwich lanes; local fork only) ---
VICTIM_PRIVATE_KEY=
ATTACKER_PRIVATE_KEY=

# --- Keeper (scripts/keeper.ts) ---
# Poll settings for the async handle-resolution problem (build.md F3).
KEEPER_POLL_INTERVAL_MS=2000
KEEPER_MAX_WAIT_MS=120000
