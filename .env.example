# Copy to .env and fill in. Never commit .env.

# --- Sepolia deploy (Stage 8, and the F9 fallback if Docker stays unavailable) ---
# Public nodes rate-limit hard; use Alchemy/Infura for anything beyond a read.
SEPOLIA_RPC_URL=
# --- three roles, three keys (run scripts/setup-operators.ts to split them) ---
# DEPLOYER holds `owner` — can install a maker and set its fee. Keep cold.
DEPLOYER_PRIVATE_KEY=
# KEEPER needs gas and uptime, holds no capital, cannot steal. Safe to run hot.
KEEPER_PRIVATE_KEY=
# MAKER holds trading inventory and takes market risk. No admin rights.
MAKER_PRIVATE_KEY=

# --- Demo wallets (Stage 5 sandwich lanes; local fork only) ---
VICTIM_PRIVATE_KEY=
ATTACKER_PRIVATE_KEY=

# --- Keeper (scripts/keeper.ts) ---
# Poll settings for the async handle-resolution problem (build.md F3).
# clearBatch resolves two handles back to back, so the worst case is twice this.
# Keep that sum comfortably under the contract's SETTLE_TIMEOUT (5 min) or a
# slow-but-healthy settlement loses the race to the cancel that refunds it.
KEEPER_POLL_INTERVAL_MS=2000
KEEPER_MAX_WAIT_MS=60000
# How long a submitted tx may stay unmined before the keeper stops waiting on it.
KEEPER_TX_WAIT_MS=90000
